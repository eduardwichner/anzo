# Copy to .env (mode 640, owner <the developer account>:anzo) and fill in SESSION_SECRET:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
SESSION_SECRET=change-me-to-96-hex-characters
ANZO_DATA_DIR=/opt/anzo/data
ANZO_CONTENT_DIR=/opt/anzo/content
ANZO_AUDIO_DIR=/opt/anzo/audio
LOG_LEVEL=info
# The reverse proxy's address: only it may set X-Forwarded-For / X-Forwarded-Proto (comma-separated; default loopback)
ANZO_TRUST_PROXY=192.0.2.1
TZ=Europe/Amsterdam
# This installation's addresses, for you and the docs (docs/operator-guide.md); npm run test:live uses ANZO_PUBLIC_URL
ANZO_PUBLIC_URL=https://anzo.your-domain.example
ANZO_LAN_URL=http://192.0.2.10:3000
# 1 = git push after each correction made in Admin → Corrections (needs a remote; docs/operator-guide.md "Version history (git)")
ANZO_GIT_AUTO_PUSH=0
# The developer account: owns /opt/anzo, runs the content job and the disk check (scripts/install-ops.sh; default anzo-dev)
ANZO_DEV_USER=anzo-dev

[Unit]
Description=Anzo weekly database backup
Documentation=file:///opt/anzo/README.md
After=anzo.service

[Service]
Type=oneshot
User=anzo
Group=anzo
ExecStart=/opt/anzo/scripts/backup-db.sh
# A hung run must not block every later run of its timer.
TimeoutStartSec=15min
# stdout goes to the journal; the script also appends to /var/log/anzo/backup.log.
NoNewPrivileges=true
ProtectSystem=strict
# data/ must be writable for SQLite's WAL shared-memory file while reading the live database.
ReadWritePaths=/opt/anzo/data /var/backups/anzo /var/log/anzo
PrivateTmp=true

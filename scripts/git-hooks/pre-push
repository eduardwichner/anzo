#!/bin/sh
# pre-push hook (switched on with: git config core.hooksPath scripts/git-hooks): nothing reaches a remote unless the
# repository is ready for a public one — npm run publish:check -- --public --history must say ready (docs/operator-guide.md,
# "Version history (git)"). The remote is push-only: this hook guards what goes out; nothing ever comes back in.
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! npm run --silent publish:check -- --public --history; then
  echo >&2
  echo "pre-push: publish:check is not ready — nothing was pushed. Fix what it lists, commit, and push again (docs/operator-guide.md, section Version history)." >&2
  exit 1
fi
